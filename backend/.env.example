# Copy this file to .env and fill in real values. Never commit the real .env.

# --- App ---
NODE_ENV=development
PORT=3000

# --- Database (PostgreSQL) ---
# Local dev via docker-compose:
DATABASE_URL="postgresql://clinic_app:changeme@localhost:5432/clinic_db?schema=public"

# --- JWT ---
# Generate strong random secrets, e.g.: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- CORS ---
# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# --- File storage ---
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./storage
STORAGE_BUCKET=

# --- Notifications (mock provider until real credentials are supplied) ---
EMAIL_PROVIDER=mock
EMAIL_API_KEY=
SMS_API_KEY=

# --- Initial admin seed (used only by `prisma/seed.ts`; required to create
#     the first SUPER_ADMIN account — no default/hard-coded password exists) ---
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
